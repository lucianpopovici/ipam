<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>TestProj — Post-Deployment Checklist — Test wave</title>
  <style>
    body { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 9.5pt; color: #222; margin: 0; }
    h1   { font-size: 20pt; margin-bottom: 4px; }
    h2   { font-size: 13pt; border-bottom: 2px solid #003366; padding-bottom: 4px; margin-top: 2em; color: #003366; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
    th, td { border: 1px solid #ccc; padding: 4px 8px; text-align: left; font-size: 8.5pt; }
    th   { background: #e8ecf4; font-weight: bold; }
    tr:nth-child(even) td { background: #f7f8fb; }
    .cover { text-align: center; padding: 60px 40px 40px; }
    .cover-sub { color: #555; font-size: 12pt; margin-bottom: 6px; }
    .meta  { color: #666; font-size: 9pt; margin-top: 6px; }
    .badge { display: inline-block; padding: 1px 7px; border-radius: 3px;
             font-size: 8pt; font-weight: bold; }
    .badge-critical  { background: #f8d7da; color: #721c24; }
    .badge-standard  { background: #fff3cd; color: #856404; }
    .badge-advisory  { background: #e2e3e5; color: #383d41; }
    .badge-pending   { background: #cfe2ff; color: #084298; }
    .badge-pass      { background: #d1e7dd; color: #0a3622; }
    .badge-fail      { background: #f8d7da; color: #721c24; }
    .badge-skip      { background: #e2e3e5; color: #383d41; }
    .badge-na        { background: #e2e3e5; color: #383d41; }
    .row-pass td     { background: #f0faf4 !important; }
    .row-fail td     { background: #fff5f5 !important; }
    .row-pending td  { background: #f0f6ff !important; }
    .hint { font-family: 'DejaVu Sans Mono', monospace; font-size: 7.5pt;
            background: #f8f9fa; border: 1px solid #dee2e6; padding: 2px 5px;
            display: block; margin-top: 3px; }
    .result-col { width: 10%; }
    .notes-col  { width: 22%; }
    .signoff    { margin-top: 40px; border-top: 2px solid #003366; padding-top: 20px; }
    .signoff table { width: auto; min-width: 60%; }
    .signoff td, .signoff th { border: none; padding: 3px 16px 3px 0; }
    .sig-line   { border-top: 1px solid #999; width: 200px; margin-top: 30px; }
    .footer     { color: #888; font-size: 7.5pt; text-align: center; margin-top: 50px; }
    .section    { page-break-inside: avoid; }
    @page { margin: 2cm; }
  </style>
</head>
<body>


<div class="cover">
  <h1>TestProj</h1>
  <div class="cover-sub">Post-Deployment Verification Checklist</div>
  <div class="meta">Test wave</div>
  <div class="meta">Generated: 2026-05-18</div>
  <div class="meta">Status: <strong>in-progress</strong></div>
</div>










<h2>Summary</h2>
<table>
  <tr><th>Total checks</th><td>1</td></tr>
  <tr><th>Critical</th><td>0</td></tr>
  <tr><th>Pass</th><td>0</td></tr>
  <tr><th>Fail</th><td>0</td></tr>
  <tr><th>Skip / N/A</th><td>0</td></tr>
  <tr><th>Pending</th><td>1</td></tr>
</table>








<h2>Standard Checks</h2>
<div class="section">
<table>
  <thead>
    <tr>
      <th style="width:38%">Check / Expected result / Hint</th>
      <th class="result-col">Result</th>
      <th class="notes-col">Notes</th>
      <th style="width:14%">Reported by</th>
      <th style="width:10%">Recorded</th>
    </tr>
  </thead>
  <tbody>
    
    <tr class="row-pending">
      <td>
        <strong>Verify it</strong>
        
        <br><em style="color:#555">Expected:</em> OK
        
        
      </td>
      <td><span class="badge badge-pending">pending</span></td>
      <td style="font-size:8pt"></td>
      <td style="font-size:8pt"></td>
      <td style="font-size:7.5pt;color:#666">
        
      </td>
    </tr>
    
  </tbody>
</table>
</div>







<div class="signoff">
  <h2>Customer Acceptance</h2>
  
  <p style="color:#555">Awaiting sign-off.</p>
  <table style="margin-top:20px">
    <tr>
      <td style="padding-right:40px">
        <div class="sig-line"></div>
        <p style="font-size:8pt;color:#555">Customer Engineer &nbsp;&nbsp; Date</p>
      </td>
      <td>
        <div class="sig-line"></div>
        <p style="font-size:8pt;color:#555">Approved by (Engineering) &nbsp;&nbsp; Date</p>
      </td>
    </tr>
  </table>
  
</div>

<div class="footer">
  Generated by IPAM · TestProj · Test wave · Post-Deployment
</div>

</body>
</html>
