[MASTER]
jobs=4
extension-pkg-whitelist=redis,flask

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-lines,
    fixme,
    import-outside-toplevel,
    broad-except,
    redefined-outer-name,
    contextmanager-generator-missing-cleanup,
    duplicate-code,
    attribute-defined-outside-init,
    global-statement,
    cyclic-import,
    unused-argument,
    too-many-positional-arguments,
    R0917,
    too-many-nested-blocks,
    too-many-return-statements,
    invalid-name,
    wrong-import-position,
    wrong-import-order,
    # Marshmallow/flask-smorest schema classes have no public methods by design
    too-few-public-methods,
    # View functions with multiple early returns need not be consistent
    inconsistent-return-statements,

[FORMAT]
max-line-length=120
indent-string='    '

[DESIGN]
max-attributes=10
max-args=7
max-locals=15

[BASIC]
good-names=i,j,k,ex,Run,_

[PYLINT]
unsafe-load-any-extension=True
